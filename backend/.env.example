# Alibaba Cloud DashScope (Qwen3-TTS) - Singapore / international region.
# Get a key: https://modelstudio.console.alibabacloud.com/ap-southeast-1/
# Leave this UNSET (or blank) to run the Stage-1 fake provider, no key needed.
DASHSCOPE_API_KEY=

# Comma-separated allowed origins for CORS. Use * for local dev,
# tighten to your Vercel URL in production, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=*
